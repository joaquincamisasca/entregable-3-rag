# --- Embeddings (búsqueda semántica) ---
# "local" (default, gratis, sin API key) u "openai" (requiere OPENAI_API_KEY con crédito)
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Generación de respuestas ---
# "ollama" (default, 100% gratis y local, requiere tener Ollama instalado
# y corriendo — ver README.md), "anthropic" u "openai" (requieren key y
# crédito cargado en la cuenta correspondiente)
GENERATION_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Solo necesarias si GENERATION_PROVIDER=openai (o EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=sk-tu-api-key-de-openai-aca
OPENAI_MODEL=gpt-4o

# Solo necesaria si GENERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=tu-api-key-de-anthropic-aca
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cantidad de fragmentos a recuperar por consulta (recomendado: 3 a 5)
RAG_TOP_K=4
